/* Slowsky d4: the tool shell. Full-screen app frame: bar / workspace / timeline / status.
   Rules: no pills (0-4 px corners; circles only for the gold ring and small dots), few dividers,
   sky pixels never recoloured, shifted or crossfaded between dates. */

@property --insp { syntax: "<length>"; inherits: true; initial-value: 0px; }

:root {
    --bar-h: 48px;
    --tl-h: 136px;
    --st-h: 26px;
    --canvas: #e6e8ed;
    --canvas-dot: #d3d7df;
    --hud: rgba(255, 255, 255, .94);
    --hud-line: rgba(15, 20, 34, .08);
    --gold: #ffc861;
    --brighter: rgb(243, 152, 58);
    --fainter: rgb(92, 150, 240);
    --tip-bg: #0f1422;
    --tip-ink: #eef1f6;
    --seg-on: #ffffff;
}
[data-theme="dark"] {
    --canvas: #0c0e13;
    --canvas-dot: #1a1e28;
    --hud: rgba(20, 23, 31, .94);
    --hud-line: rgba(255, 255, 255, .06);
    --tip-bg: #eef1f6;
    --tip-ink: #0f1422;
    --seg-on: #2a3040;
}

html, body { height: 100%; }
body {
    display: grid;
    grid-template-rows: var(--bar-h) minmax(0, 1fr) var(--tl-h) var(--st-h);
    height: 100dvh; overflow: hidden; font-size: 13px; line-height: 1.4;
}
.ic { width: 16px; height: 16px; flex: none; }
.ic.big { width: 28px; height: 28px; }
.faint { color: var(--faint); }
[hidden] { display: none !important; }

/* ---------- Top bar ---------- */
.bar {
    display: flex; align-items: center; gap: 10px; padding: 0 12px; background: var(--surface);
    position: relative; z-index: 30;
}
.brand { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); text-decoration: none; font-weight: 500; font-size: 14px; padding-right: 6px; }
.brand img { width: 22px; height: 22px; }
.bar .btn { height: 32px; font-size: 13px; }
.bar .btn.icon { width: 32px; }
.bar-gap { flex: 1; }

.seg { background: var(--surface-2); border-color: transparent; }
.seg button { height: 26px; font-size: 12.5px; padding: 0 10px; }
.seg button[aria-checked="true"], .seg button[aria-selected="true"], .seg button[aria-pressed="true"] {
    background: var(--seg-on); color: var(--ink); box-shadow: 0 1px 2px rgba(15, 20, 34, .14);
}
.seg button kbd { font-size: 10px; padding: 0 4px; border-bottom-width: 1px; background: transparent; color: var(--faint); }
.seg .count { font-family: var(--mono); font-size: 11px; color: var(--accent); }
.seg .count:empty { display: none; }

.target-btn {
    display: inline-flex; align-items: center; gap: 8px; height: 32px; padding: 0 8px 0 4px; min-width: 0;
    border: 1px solid var(--line-2); border-radius: var(--r); background: var(--surface); cursor: pointer;
    font-weight: 500; transition: border-color .15s var(--ease), background-color .15s var(--ease);
}
.target-btn:hover { background: var(--surface-2); }
.target-btn img { width: 24px; height: 24px; border-radius: var(--r-sm); background: var(--sky); object-fit: cover; }
.target-btn #target-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 22ch; }
.target-btn kbd { font-size: 10px; padding: 0 4px; border-bottom-width: 1px; }
.target-btn .ic { width: 12px; height: 12px; color: var(--mute); }
.upload .ic { width: 15px; height: 15px; }

/* ---------- Workspace ---------- */
.work {
    position: relative; overflow: hidden; container-type: size;
    background-color: var(--canvas);
    background-image: radial-gradient(var(--canvas-dot) 1px, transparent 1.2px);
    background-size: 18px 18px;
    transition: --insp .32s var(--ease-out), background-color .2s var(--ease);
}
.work.inspecting { --insp: 372px; }

.stage {
    --side: 148px;
    --w: max(160px, min(calc(100cqh - 40px), calc(100cqw - var(--side) - var(--insp))));
    position: absolute; top: 50%; left: calc((100cqw - var(--insp)) / 2 + 20px);
    width: var(--w); height: var(--w); translate: -50% -50%;
    border-radius: var(--r); overflow: hidden; background: var(--sky);
    box-shadow: 0 1px 2px rgba(0, 0, 0, .2), 0 24px 60px -30px rgba(0, 0, 0, .55);
}
.stage .sky {
    position: absolute; inset: 0; border-radius: 0; aspect-ratio: auto; cursor: crosshair;
    transform: translate(var(--pan-x, 0px), var(--pan-y, 0px)) scale(var(--zoom, 1));
    transform-origin: 50% 50%; touch-action: none;
    transition: opacity .2s var(--ease-out);
}
.stage .sky.panning { cursor: grabbing; }
.stage .sky canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; image-rendering: auto; }
.stage .sky.dim { opacity: .6; }
.stage .sky.plate-in { animation: plate-in .25s var(--ease-out); }
@keyframes plate-in { from { opacity: .6; scale: 1.04; } }
.stage.is-empty { background: transparent; box-shadow: none; overflow: visible; }

/* Overlay: ring, trail, candidate markers. Same 480-unit box as the saved PNGs. */
.overlay { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; overflow: visible; }
#ring { fill: none; stroke: var(--gold); stroke-width: 1.6; vector-effect: non-scaling-stroke; filter: drop-shadow(0 0 1px rgba(0, 0, 0, .7)); }
#ring.draw { stroke-dasharray: 100; animation: ring-draw .6s var(--ease-out) both; }
@keyframes ring-draw { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }
#trail circle { fill: var(--gold); opacity: .55; }
#trail path { fill: none; stroke: var(--gold); stroke-width: 1; stroke-dasharray: 2 4; opacity: .5; vector-effect: non-scaling-stroke; }
.overlay .off { display: none; }
#cands .cand rect { fill: none; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
#cands .cand.brighter rect { stroke: var(--brighter); }
#cands .cand.fainter rect { stroke: var(--fainter); }
#cands .cand text { font: 500 11px var(--mono); fill: #fff; paint-order: stroke; stroke: rgba(0, 0, 0, .8); stroke-width: 3px; }
#cands .cand.on rect { stroke-width: 2.5; }

.loupe {
    position: absolute; z-index: 3; width: 150px; height: 150px; pointer-events: none; overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .75); border-radius: var(--r); background: var(--sky);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, .5), 0 12px 30px -10px rgba(0, 0, 0, .7);
}
.loupe canvas, .loupe img { position: absolute; image-rendering: pixelated; }
.loupe::after { content: ""; position: absolute; left: 50%; top: 50%; width: 9px; height: 9px; translate: -50% -50%; border: 1px solid rgba(255, 200, 97, .9); }

/* Empty state (My frames, nothing loaded): the stage becomes a drop target */
.empty {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 8px; text-align: center; padding: 24px; color: var(--ink-2);
    border: 1.5px dashed var(--line-2); border-radius: var(--r); background: var(--surface);
}
.empty .ic.big { color: var(--accent); margin-bottom: 4px; }
.empty-title { font-size: 16px; font-weight: 500; color: var(--ink); }
.empty-sub { font-size: 12.5px; color: var(--mute); max-width: 36ch; }
.empty-actions { display: flex; gap: 8px; margin-top: 10px; }
.empty-lock { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; font-size: 12px; color: var(--faint); }
.empty-lock .ic { width: 13px; height: 13px; }

/* HUD: small floating cards on the canvas */
.hud {
    position: absolute; z-index: 5; background: var(--hud); border: 1px solid var(--hud-line);
    border-radius: var(--r); box-shadow: var(--shadow); backdrop-filter: blur(8px);
}
.hud-id { left: 12px; top: 12px; padding: 8px 12px 9px; min-width: 168px; max-width: 240px; }
.hud-name { font-weight: 500; font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hud-row { display: flex; gap: 10px; font-size: 12px; margin-top: 1px; }
.hud-src { font-size: 11px; color: var(--faint); margin-top: 3px; }

.tools {
    left: 12px; top: 50%; translate: 0 -50%; display: flex; flex-direction: column; gap: 2px; padding: 4px;
}
.tool {
    position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    width: 36px; min-height: 34px; padding: 0; border: 0; border-radius: var(--r-sm); background: transparent;
    color: var(--ink-2); cursor: pointer; transition: background-color .12s var(--ease), color .12s var(--ease);
}
.tool:hover:not(:disabled) { background: var(--surface-2); color: var(--ink); }
.tool[aria-pressed="true"] { background: var(--accent-soft); color: var(--accent); }
.tool.held { background: var(--ink); color: var(--bg); }
.tool:disabled { opacity: .35; cursor: default; }
.tool .tl { display: none; font-size: 9.5px; line-height: 1.1; letter-spacing: .01em; }
.tool-gap { height: 1px; margin: 3px 6px; background: var(--hud-line); }
body.labels .tools { padding: 4px 3px; }
body.labels .tool { width: 62px; min-height: 42px; }
body.labels .tool .tl { display: block; }
.tool[data-tool="zoom"] .tl { display: block; font-size: 9.5px; }

.hud-scale { left: 12px; bottom: 12px; display: flex; align-items: center; gap: 14px; padding: 6px 12px; font-size: 11.5px; }
.compass { font-family: var(--mono); color: var(--mute); letter-spacing: .02em; }
.compass b { font-weight: 500; color: var(--ink); }
.scale { display: inline-flex; align-items: center; gap: 6px; }
.scale i { display: block; height: 6px; width: 40px; border: 1.5px solid var(--ink-2); border-top: 0; transition: width .2s var(--ease-out); }

.caveat {
    right: 12px; bottom: 12px; display: flex; align-items: flex-start; gap: 8px; padding: 8px 12px;
    max-width: min(320px, 32cqw); font-size: 12px; color: var(--ink-2); transition: right .32s var(--ease-out);
}
.caveat .ic { color: var(--warm); width: 14px; height: 14px; margin-top: 1px; }
.work.inspecting .caveat { right: calc(var(--insp) + 4px); }

.minimap { right: 12px; top: 12px; width: 196px; padding: 8px 10px 10px; transition: opacity .2s var(--ease-out); }
.mm-label { display: block; font-size: 10.5px; color: var(--faint); margin-bottom: 4px; letter-spacing: .02em; }
.mm-plot {
    position: relative; height: 88px; border-radius: var(--r-sm); background: var(--surface-2);
    background-image: linear-gradient(var(--hud-line) 1px, transparent 1px), linear-gradient(90deg, var(--hud-line) 1px, transparent 1px);
    background-size: 25% 33.33%;
}
.mm-plot [data-target] {
    position: absolute; width: 18px; height: 18px; translate: -50% -50%; border: 0; padding: 0; background: transparent; cursor: pointer;
}
.mm-plot [data-target]::before { content: ""; position: absolute; inset: 5px; border-radius: 50%; background: var(--mute); transition: background-color .15s, scale .15s var(--ease-out); }
.mm-plot [data-target]:hover::before { background: var(--ink); scale: 1.3; }
.mm-plot [data-target][aria-current="true"]::before { background: var(--gold); box-shadow: 0 0 0 2px var(--hud), 0 0 0 3px var(--gold); }
.work.inspecting .minimap { opacity: 0; pointer-events: none; }

.coach { right: 12px; top: 128px; width: 300px; padding: 14px 16px 14px; z-index: 8; animation: sk-enter .32s var(--ease-out) both; }
.coach-k { font-size: 11px; color: var(--accent); font-weight: 500; }
.coach h2 { font-size: 15px; margin: 2px 0 6px; }
.coach p:not(.coach-k) { font-size: 12.5px; color: var(--ink-2); }
.coach-actions { display: flex; gap: 6px; margin-top: 12px; }
.coach-actions .btn { height: 30px; font-size: 12.5px; padding: 0 10px; }
.coach-mark {
    position: fixed; z-index: 60; pointer-events: none; border: 2px solid var(--accent); border-radius: var(--r);
    box-shadow: 0 0 0 9999px rgba(10, 12, 18, .32); transition: all .28s var(--ease-out);
}
.coach-tip {
    position: fixed; z-index: 61; width: 260px; padding: 12px 14px; background: var(--surface); border-radius: var(--r);
    box-shadow: var(--shadow); font-size: 12.5px; transition: all .28s var(--ease-out);
}
.coach-tip b { display: block; font-weight: 500; margin-bottom: 2px; }
.coach-tip .row { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }

/* Jobs: the per-file processing queue */
.jobs { right: 12px; top: 12px; width: 320px; max-height: calc(100cqh - 80px); display: flex; flex-direction: column; z-index: 7; }
.jobs header { display: flex; align-items: center; gap: 8px; padding: 8px 8px 6px 12px; }
.jobs header b { font-weight: 500; }
.jobs header .btn { margin-left: auto; }
.btn.sm { height: 26px; font-size: 12px; padding: 0 8px; }
.btn.icon.sm { width: 26px; padding: 0; }
.jobs ol { list-style: none; margin: 0; padding: 0 6px 6px; overflow: auto; }
.job { padding: 7px 6px 8px; border-radius: var(--r-sm); }
.job + .job { margin-top: 2px; }
.job-top { display: flex; align-items: center; gap: 6px; font-size: 12px; }
.job-top .ic { width: 13px; height: 13px; color: var(--mute); }
.job-name { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-family: var(--mono); font-size: 11.5px; }
.job-stages { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 5px; }
.chip { font-family: var(--mono); font-size: 10px; line-height: 16px; padding: 0 5px; border-radius: var(--r-sm); background: var(--surface-2); color: var(--faint); transition: background-color .15s, color .15s; }
.chip.done { color: var(--ink-2); background: color-mix(in srgb, var(--accent) 12%, var(--surface-2)); }
.chip.now { color: var(--accent-ink); background: var(--accent); }
.chip.err { color: #fff; background: #c2412d; }
.job-bar { height: 2px; margin-top: 6px; background: var(--surface-2); overflow: hidden; }
.job-bar i { display: block; height: 100%; width: var(--p, 0%); background: var(--accent); transition: width .25s var(--ease-out); }
.job.err .job-bar i { background: #c2412d; }
.job-why { font-size: 11.5px; color: #c2412d; margin-top: 4px; }
[data-theme="dark"] .job-why { color: #ff8a73; }

/* Inspector: one floating panel, closed by default */
.inspector {
    right: 12px; top: 12px; bottom: 12px; width: 348px; display: flex; flex-direction: column; z-index: 9;
    animation: insp-in .32s var(--ease-out) both;
}
@keyframes insp-in { from { opacity: 0; translate: 16px 0; } }
.inspector > header { display: flex; align-items: center; gap: 6px; padding: 6px 6px 6px 8px; }
.tabs { display: flex; gap: 2px; flex: 1; }
.tabs button {
    height: 28px; padding: 0 8px; border: 0; border-radius: var(--r-sm); background: transparent; color: var(--mute);
    cursor: pointer; font-size: 12.5px; font-weight: 500;
}
.tabs button:hover { color: var(--ink); background: var(--surface-2); }
.tabs button[aria-selected="true"] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--accent); border-radius: 0; }
.tab-panel { flex: 1; overflow: auto; padding: 6px 14px 16px; font-size: 12.5px; }
.tab-panel h3 { font-size: 14px; margin: 6px 0 4px; }
.tab-panel p { color: var(--ink-2); margin: 0 0 8px; }
.tab-panel .help-line { font-size: 12px; color: var(--mute); margin: 2px 0 10px; }
.tab-panel .sec { font-size: 10.5px; color: var(--faint); letter-spacing: .03em; margin: 14px 0 4px; }
dl.kv { display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; margin: 0; }
dl.kv dt { color: var(--mute); }
dl.kv dd { margin: 0; font-family: var(--mono); font-size: 11.5px; color: var(--ink); overflow-wrap: anywhere; }
dl.kv dd button { all: unset; cursor: copy; font: inherit; border-bottom: 1px dotted var(--line-2); }
.warn-list { margin: 4px 0 0; padding: 0; list-style: none; }
.warn-list li { display: flex; gap: 6px; padding: 3px 0; color: var(--ink-2); }
.warn-list li::before { content: ""; flex: none; width: 6px; height: 6px; margin-top: 6px; background: var(--warm); border-radius: 1px; }
.cand-row {
    display: flex; align-items: center; gap: 10px; width: 100%; padding: 6px 6px; border: 0; border-radius: var(--r-sm);
    background: transparent; cursor: pointer; text-align: left; font-size: 12.5px;
}
.cand-row:hover, .cand-row.on { background: var(--surface-2); }
.cand-row .n { display: grid; place-items: center; width: 20px; height: 20px; border: 1.5px solid; border-radius: var(--r-sm); font: 500 11px var(--mono); }
.cand-row.brighter .n { color: var(--warm); }
.cand-row.fainter .n { color: var(--fainter); }
.cand-row .sig { margin-left: auto; font-family: var(--mono); font-size: 11.5px; color: var(--mute); }
.ai-label { display: inline-block; font-family: var(--mono); font-size: 10.5px; padding: 1px 6px; border: 1px solid var(--line-2); border-radius: var(--r-sm); color: var(--mute); }
.ai-box { margin-top: 8px; padding: 10px 12px; background: var(--surface-2); border-radius: var(--r-sm); color: var(--ink-2); }

/* Drag-and-drop overlay over the whole workspace */
.drop {
    position: absolute; inset: 10px; z-index: 40; display: grid; place-items: center; pointer-events: none;
    border: 2px dashed var(--accent); border-radius: var(--r);
    background: color-mix(in srgb, var(--accent) 10%, transparent); backdrop-filter: blur(2px);
    animation: sk-enter .18s var(--ease-out) both;
}
.drop > div { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 18px 22px; background: var(--surface); border-radius: var(--r); box-shadow: var(--shadow); }
.drop .ic.big { color: var(--accent); }
.drop b { font-weight: 500; font-size: 14px; }
.drop span { font-size: 12px; color: var(--mute); }

.toast {
    position: absolute; left: 50%; bottom: 16px; translate: -50% 0; z-index: 45; padding: 7px 12px; border-radius: var(--r);
    background: var(--tip-bg); color: var(--tip-ink); font-size: 12.5px; box-shadow: var(--shadow);
    animation: toast-in .22s var(--ease-out) both;
}
@keyframes toast-in { from { opacity: 0; translate: -50% 6px; } }

/* ---------- Timeline ---------- */
.timeline {
    display: grid; grid-template-columns: 184px minmax(0, 1fr); gap: 0 8px; padding: 10px 14px 10px 12px;
    background: var(--surface); position: relative; z-index: 20;
}
.transport { display: flex; flex-direction: column; gap: 8px; justify-content: center; }
.tp-row { display: flex; gap: 4px; align-items: center; }
.tp-row .btn { height: 34px; }
.tp-row .btn.icon { width: 34px; }
.tp-row .play { width: 44px !important; background: var(--ink); border-color: var(--ink); color: var(--bg); }
.tp-row .play:hover { background: var(--ink); filter: brightness(1.15); }
.tp-row .ic { width: 14px; height: 14px; }
.speed { align-self: flex-start; }
.speed button { height: 24px; padding: 0 9px; font-family: var(--mono); font-size: 11.5px; }
.ab { display: flex; align-items: center; gap: 6px; font-size: 11.5px; }
.ab .a, .ab .b { display: grid; place-items: center; width: 16px; height: 16px; border-radius: var(--r-sm); font-size: 10px; font-weight: 500; color: #fff; }
.ab .a { background: var(--fainter); }
.ab .b { background: var(--brighter); }

.tracks { display: flex; flex-direction: column; justify-content: center; gap: 14px; min-width: 0; }
.track { display: grid; grid-template-columns: 56px minmax(0, 1fr) 76px; align-items: center; gap: 10px; }
.track-label { font-size: 11px; color: var(--faint); letter-spacing: .02em; }
.readout { font-size: 12px; text-align: right; color: var(--ink); }
#track-dates { grid-template-columns: 56px minmax(0, 1fr) 76px; }

.lane { position: relative; margin: 0 24px; }
.lane.dates { height: 66px; cursor: pointer; }
.thumbs { position: absolute; left: 0; right: 0; top: 0; height: 44px; }
.thumb {
    position: absolute; top: 0; width: 44px; height: 44px; translate: -50% 0; padding: 0; border: 0; border-radius: var(--r-sm);
    background: var(--sky); overflow: hidden; cursor: pointer; opacity: .62;
    box-shadow: 0 0 0 1px var(--line-2); transition: opacity .15s var(--ease), box-shadow .15s var(--ease), translate .15s var(--ease-out);
}
.thumb img, .thumb canvas { width: 100%; height: 100%; object-fit: cover; display: block; }
.thumb:hover { opacity: 1; translate: -50% -2px; }
.thumb.on { opacity: 1; box-shadow: 0 0 0 2px var(--accent); }
.thumb.loading { animation: thumb-wait 1.2s var(--ease) infinite; }
@keyframes thumb-wait { 50% { opacity: .35; } }
.thumb .ab-tag { position: absolute; left: 2px; top: 2px; width: 14px; height: 14px; display: grid; place-items: center; border-radius: var(--r-sm); font: 500 9.5px var(--font); color: #fff; }
.thumb.a .ab-tag { background: var(--fainter); }
.thumb.b .ab-tag { background: var(--brighter); }
.thumb.a { box-shadow: 0 0 0 2px var(--fainter); opacity: 1; }
.thumb.b { box-shadow: 0 0 0 2px var(--brighter); opacity: 1; }
.axis { position: absolute; left: 0; right: 0; bottom: 0; height: 16px; font-size: 10.5px; color: var(--faint); }
.axis::before { content: ""; position: absolute; left: -24px; right: -24px; top: 0; height: 1px; background: var(--line); }
.axis .tick { position: absolute; top: 0; translate: -50% 0; padding-top: 3px; white-space: nowrap; }
.axis .tick::before { content: ""; position: absolute; left: 50%; top: -3px; width: 1px; height: 4px; background: var(--line-2); }
.axis .tick.year { color: var(--mute); }
.axis .gap { position: absolute; top: -2px; height: 5px; background: repeating-linear-gradient(90deg, var(--line-2) 0 2px, transparent 2px 5px); }
.playhead { position: absolute; top: -4px; bottom: 14px; width: 2px; margin-left: -1px; background: var(--accent); cursor: ew-resize; z-index: 2; }
.playhead i { position: absolute; left: 50%; top: -3px; width: 10px; height: 8px; translate: -50% 0; background: var(--accent); border-radius: 1px; }
.playhead:focus-visible { box-shadow: var(--focus); }
.peek {
    position: absolute; bottom: calc(100% + 10px); translate: -50% 0; z-index: 50; padding: 4px; background: var(--surface);
    border-radius: var(--r); box-shadow: var(--shadow), 0 0 0 1px var(--line); pointer-events: none;
    animation: sk-enter .15s var(--ease-out) both;
}
.peek img { display: block; width: 132px; height: 132px; border-radius: var(--r-sm); background: var(--sky); object-fit: cover; }
.peek span { display: block; text-align: center; font-size: 11px; padding: 3px 0 1px; }

.lane.colour { height: 22px; margin-top: 12px; border-radius: var(--r-sm); background: var(--surface-2); cursor: pointer; touch-action: none; }
.eyes {
    position: absolute; left: 0; top: 0; bottom: 0; width: 6.52%; border-radius: var(--r-sm) 0 0 var(--r-sm);
    background: linear-gradient(90deg, #6b3fd6, #3b6ff0, #2bb3b1, #6cc04a, #e8d23a, #ee8a2c, #d8392e);
}
.eyes span { position: absolute; left: 0; bottom: calc(100% + 2px); font-size: 10px; color: var(--mute); white-space: nowrap; }
.bands { position: absolute; inset: 0; }
.band {
    position: absolute; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--accent) 14%, transparent); font: 10px var(--mono); color: var(--mute);
    transition: background-color .15s var(--ease);
}
.band + .band { box-shadow: inset 1px 0 0 var(--surface); }
.band:hover { background: color-mix(in srgb, var(--accent) 24%, transparent); }
.band.saved { background: color-mix(in srgb, var(--accent) 32%, transparent); color: var(--ink); }
.band.on { color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--accent); }
.cthumb { position: absolute; top: -5px; bottom: -5px; width: 2px; margin-left: -1px; background: var(--ink); cursor: ew-resize; z-index: 2; }
.cthumb i { position: absolute; left: 50%; top: -3px; width: 10px; height: 8px; translate: -50% 0; background: var(--ink); border-radius: 1px; }
.cthumb:focus-visible { box-shadow: var(--focus); }

/* ---------- Status bar ---------- */
.status {
    display: flex; align-items: center; gap: 14px; padding: 0 12px; background: var(--surface-2); font-size: 11.5px;
    color: var(--mute); position: relative; z-index: 25; min-width: 0;
}
.st-help { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: opacity .12s var(--ease-out); }
.st-help.swap-out { opacity: 0; }
.st-help b { color: var(--ink); font-weight: 500; margin-right: 6px; }
.term { all: unset; cursor: help; color: var(--ink-2); border-bottom: 1px dotted currentColor; }
.term:focus-visible { box-shadow: var(--focus); }
.st-load { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-2); }
.st-load i { display: block; width: 90px; height: 2px; background: var(--line-2); position: relative; overflow: hidden; }
.st-load i::after { content: ""; position: absolute; inset: 0; width: var(--p, 30%); background: var(--accent); transition: width .2s var(--ease-out); }
.st-load.busy i::after { width: 35%; animation: sk-bar 1.1s var(--ease) infinite; }
.st-coord, .st-ai { all: unset; cursor: pointer; white-space: nowrap; }
.st-coord:hover, .st-ai:hover { color: var(--ink); }
.st-coord:focus-visible, .st-ai:focus-visible { box-shadow: var(--focus); }
.st-ai { color: var(--ink-2); border-bottom: 1px dotted currentColor; }
.st-mock { font-family: var(--mono); font-size: 10.5px; padding: 0 5px; border: 1px solid var(--line-2); border-radius: var(--r-sm); color: var(--faint); }
.about {
    position: absolute; right: 12px; bottom: calc(100% + 8px); width: 320px; padding: 12px 14px; z-index: 70;
    background: var(--surface); border-radius: var(--r); box-shadow: var(--shadow), 0 0 0 1px var(--line); color: var(--ink-2);
    font-size: 12.5px; animation: sk-enter .18s var(--ease-out) both;
}
.about a { display: inline-block; margin-top: 6px; }

/* ---------- Picker (command palette) ---------- */
.picker { position: fixed; inset: 0; z-index: 80; display: flex; justify-content: center; align-items: flex-start; padding-top: 12vh; background: rgba(10, 12, 18, .3); animation: fade-in .15s var(--ease-out) both; }
@keyframes fade-in { from { opacity: 0; } }
.picker-box { width: min(560px, calc(100vw - 24px)); background: var(--surface); border-radius: var(--r); box-shadow: var(--shadow), 0 0 0 1px var(--line); overflow: hidden; animation: sk-enter .2s var(--ease-out) both; }
.picker-search { display: flex; align-items: center; gap: 10px; padding: 0 14px; height: 48px; color: var(--mute); }
.picker-search input { flex: 1; border: 0; outline: 0; background: transparent; font-size: 15px; color: var(--ink); min-width: 0; }
.picker-search input:focus-visible { box-shadow: none; }
.picker ul { list-style: none; margin: 0; padding: 4px; max-height: 50vh; overflow: auto; }
.picker li { display: flex; align-items: center; gap: 10px; padding: 6px 8px; border-radius: var(--r-sm); cursor: pointer; }
.picker li img { width: 32px; height: 32px; border-radius: var(--r-sm); background: var(--sky); object-fit: cover; }
.picker li .nm { font-weight: 500; }
.picker li .sub { display: block; font-size: 12px; color: var(--mute); }
.picker li .k { margin-left: auto; font-size: 11px; color: var(--faint); }
.picker li[aria-selected="true"] { background: var(--accent-soft); }
.picker li.note { cursor: default; color: var(--mute); font-size: 12.5px; }

/* ---------- Tooltip and glossary popover ---------- */
.tip {
    position: fixed; z-index: 90; max-width: 280px; padding: 7px 9px; border-radius: var(--r-sm); pointer-events: none;
    background: var(--tip-bg); color: var(--tip-ink); font-size: 12px; line-height: 1.35; box-shadow: var(--shadow);
    animation: tip-in .12s var(--ease-out) both;
}
@keyframes tip-in { from { opacity: 0; translate: 0 3px; } }
.tip b { font-weight: 500; }
.tip kbd { margin-left: 6px; background: transparent; color: inherit; border-color: currentColor; opacity: .7; font-size: 10px; padding: 0 4px; border-bottom-width: 1px; }
.tip .tip-line { display: block; opacity: .78; margin-top: 2px; }
.gloss {
    position: fixed; z-index: 91; width: 280px; padding: 10px 12px; background: var(--surface); color: var(--ink-2);
    border-radius: var(--r); box-shadow: var(--shadow), 0 0 0 1px var(--line); font-size: 12.5px;
    animation: tip-in .15s var(--ease-out) both;
}
.gloss b { display: block; color: var(--ink); font-weight: 500; margin-bottom: 2px; }

/* ---------- Phone and narrow screens ---------- */
@media (max-width: 1100px) {
    .stage { --side: 120px; }
    .work.inspecting { --insp: 0px; }
    .work.inspecting .caveat { right: 12px; }
    .kbd-opt, .target-btn kbd, .seg button kbd { display: none; }
}

@media (max-width: 899px) {
    body {
        display: grid; height: auto; min-height: 100dvh; overflow-x: hidden; overflow-y: auto; font-size: 14px;
        grid-template-columns: auto minmax(0, 1fr) auto auto auto;
        grid-template-rows: auto;
        grid-template-areas:
            "brand target upload help theme"
            "ws ws ws ws ws"
            "work work work work work"
            "mode mode mode mode mode"
            "timeline timeline timeline timeline timeline"
            "status status status status status";
        align-content: start;
    }
    .bar { display: contents; }
    .brand { grid-area: brand; padding: 8px 4px 8px 10px; }
    .brand span { display: none; }
    .brand img { width: 26px; height: 26px; }
    .target-btn { grid-area: target; height: 44px; margin: 8px 0; }
    .target-btn #target-name { max-width: none; }
    .upload { grid-area: upload; margin: 8px 0 8px 6px; height: 44px !important; width: 44px; padding: 0; justify-content: center; }
    .upload span { display: none; }
    #help-btn { grid-area: help; margin: 8px 0 8px 6px; }
    [data-theme-toggle] { grid-area: theme; margin: 8px 10px 8px 6px; }
    #share-btn { display: none; }
    .bar .btn.icon { width: 44px; height: 44px; }
    .bar-gap { display: none; }
    .seg.ws { grid-area: ws; margin: 0 10px 8px; display: grid; grid-template-columns: 1fr 1fr; }
    .seg.mode { grid-area: mode; margin: 0 10px 8px; display: grid; grid-template-columns: repeat(3, 1fr); }
    .seg button { height: 40px; justify-content: center; font-size: 14px; }

    .work { grid-area: work; container-type: inline-size; overflow: visible; display: flex; flex-direction: column; gap: 8px; padding: 0 10px 8px; background-image: none; background-color: transparent; --insp: 0px !important; }
    .stage { position: relative; left: auto; top: auto; translate: none; width: 100%; height: auto; aspect-ratio: 1; }
    .stage.is-empty { aspect-ratio: auto; min-height: 320px; }
    .hud { backdrop-filter: none; }
    .hud-id { left: 18px; top: 8px; min-width: 0; max-width: 60%; padding: 5px 8px 6px; background: rgba(5, 7, 13, .72); border-color: transparent; color: #e9edf5; box-shadow: none; }
    .hud-id .hud-src { display: none; }
    .hud-id .faint { color: #a9b1c0; }
    .hud-scale { left: 18px; bottom: auto; top: calc(100cqw - 20px - 30px); padding: 3px 8px; background: rgba(5, 7, 13, .72); border-color: transparent; color: #e9edf5; box-shadow: none; }
    .hud-scale .compass, .hud-scale .compass b { color: #e9edf5; }
    .hud-scale .scale i { border-color: #e9edf5; }
    .hud-scale .faint { color: #a9b1c0; }
    .tools { position: static; translate: none; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); order: 2; }
    .tool { width: 100%; min-height: 44px; }
    .tool-gap { display: none; }
    body.labels .tool { width: 100%; min-height: 48px; }
    body.labels .tool .tl { font-size: 9px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
    .caveat { position: static; order: 3; max-width: none; }
    .minimap { display: none; }
    .coach { position: static; width: auto; order: 4; }
    .jobs, .inspector {
        position: fixed; left: 0; right: 0; bottom: 0; top: auto; width: auto; max-height: 72dvh; z-index: 75;
        border-radius: var(--r) var(--r) 0 0; animation: sheet-in .28s var(--ease-out) both;
    }
    @keyframes sheet-in { from { translate: 0 100%; } }
    .drop { position: fixed; }
    .toast { position: fixed; bottom: 16px; }

    .timeline { grid-area: timeline; grid-template-columns: 1fr; gap: 10px; padding: 12px 10px; }
    .transport { flex-direction: row; align-items: center; justify-content: space-between; }
    .tp-row .btn.icon { width: 44px; height: 44px; }
    .tp-row .play { width: 56px !important; }
    .speed { align-self: center; }
    .speed button { height: 36px; }
    .track { grid-template-columns: minmax(0, 1fr) auto; gap: 4px 10px; }
    #track-dates { grid-template-columns: minmax(0, 1fr); }
    .track-label { grid-column: 1 / -1; }
    .lane { margin: 0 22px; }
    .lane.colour { height: 30px; margin-top: 14px; }
    .readout { text-align: left; }

    .status { grid-area: status; flex-wrap: wrap; gap: 6px 12px; padding: 10px 12px 18px; font-size: 12.5px; }
    .st-help { flex-basis: 100%; white-space: normal; }
    .st-coord { display: none; }
    .about { left: 10px; right: 10px; width: auto; }
}

@media (max-width: 380px) {
    #help-btn { display: none; }
    body { grid-template-areas:
            "brand target upload theme theme"
            "ws ws ws ws ws"
            "work work work work work"
            "mode mode mode mode mode"
            "timeline timeline timeline timeline timeline"
            "status status status status status"; }
    .speed button { padding: 0 7px; }
}

@media (prefers-reduced-motion: reduce) {
    .work { transition: none; }
    .stage .sky.plate-in, #ring.draw { animation: none; }
}

/* Slowsky revamp: shared tokens for every mockup. Light by default; [data-theme="dark"] on <html> for dark. */
@font-face { font-family: "Geist"; src: url(fonts/geist-300.woff2) format("woff2"); font-weight: 300; font-display: swap; }
@font-face { font-family: "Geist"; src: url(fonts/geist-400.woff2) format("woff2"); font-weight: 400; font-display: swap; }
@font-face { font-family: "Geist"; src: url(fonts/geist-500.woff2) format("woff2"); font-weight: 500 600; font-display: swap; }
@font-face { font-family: "Geist Mono"; src: url(fonts/geist-mono-400.woff2) format("woff2"); font-weight: 400; font-display: swap; }

:root {
    color-scheme: light;
    --bg: #f5f6f8;
    --surface: #ffffff;
    --surface-2: #eef0f4;
    --ink: #0f1422;
    --ink-2: #394150;
    --mute: #5f6879;
    --faint: #8b93a3;
    --line: #e1e4ea;
    --line-2: #cdd2db;
    --accent: #2f5fd0;
    --accent-ink: #ffffff;
    --accent-soft: #e6edfb;
    --warm: #c8661d;
    --warm-soft: #fbeee2;
    --sky: #05070d;
    --focus: 0 0 0 3px rgba(47, 95, 208, .35);
    --shadow: 0 1px 2px rgba(15, 20, 34, .05), 0 12px 32px -18px rgba(15, 20, 34, .22);
    --r: 4px;
    --r-sm: 2px;
    --font: "Geist", system-ui, sans-serif;
    --mono: "Geist Mono", ui-monospace, monospace;
    --ease: cubic-bezier(.23, 1, .32, 1);
}

[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0a0c12;
    --surface: #11141c;
    --surface-2: #181c26;
    --ink: #eef1f6;
    --ink-2: #c4cad5;
    --mute: #9aa2b2;
    --faint: #6c7486;
    --line: #232836;
    --line-2: #313848;
    --accent: #7aa2ff;
    --accent-ink: #0a0c12;
    --accent-soft: #1a2440;
    --warm: #f3a04a;
    --warm-soft: #2c1f12;
    --focus: 0 0 0 3px rgba(122, 162, 255, .4);
    --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 16px 40px -20px rgba(0, 0, 0, .7);
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
    margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font);
    font-size: 15px; line-height: 1.55; -webkit-font-smoothing: antialiased;
    transition: background-color .2s var(--ease), color .2s var(--ease);
}
h1, h2, h3 { margin: 0; font-weight: 500; letter-spacing: -.015em; text-wrap: balance; }
p { margin: 0; text-wrap: pretty; }
button, input, select { font: inherit; color: inherit; }
a { color: var(--accent); text-underline-offset: 3px; }
:focus-visible { outline: none; box-shadow: var(--focus); }
.num { font-family: var(--mono); font-variant-numeric: tabular-nums; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* Buttons: square-ish, never capsule */
.btn {
    display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 14px;
    border: 1px solid var(--line-2); border-radius: var(--r); background: var(--surface); color: var(--ink);
    cursor: pointer; font-size: 14px; font-weight: 500; white-space: nowrap;
    transition: background-color .15s var(--ease), border-color .15s var(--ease), transform .1s var(--ease);
}
.btn:hover { background: var(--surface-2); }
.btn:active { transform: translateY(1px); }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.btn.primary:hover { filter: brightness(1.06); }
.btn.ghost { border-color: transparent; background: transparent; }
.btn.ghost:hover { background: var(--surface-2); }
.btn.icon { width: 36px; padding: 0; justify-content: center; }
.btn svg { width: 16px; height: 16px; flex: none; }

/* Segmented control: square segments */
.seg { display: inline-flex; border: 1px solid var(--line-2); border-radius: var(--r); background: var(--surface); padding: 2px; gap: 2px; }
.seg button {
    height: 30px; padding: 0 12px; border: 0; border-radius: var(--r-sm); background: transparent; color: var(--mute);
    cursor: pointer; font-size: 13.5px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;
}
.seg button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }
.seg button:hover:not([aria-pressed="true"]) { color: var(--ink); background: var(--surface-2); }

/* Square checkbox row */
.check { display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 14px; color: var(--ink-2); min-height: 32px; }
.check input { appearance: none; width: 16px; height: 16px; margin: 0; border: 1.5px solid var(--line-2); border-radius: var(--r-sm); background: var(--surface); display: grid; place-content: center; flex: none; }
.check input:checked { background: var(--accent); border-color: var(--accent); }
.check input:checked::after { content: ""; width: 8px; height: 5px; border: 2px solid var(--accent-ink); border-top: 0; border-right: 0; transform: rotate(-45deg) translate(1px, -1px); }

/* Keyboard hint */
kbd { font-family: var(--mono); font-size: 11.5px; padding: 1px 5px; border: 1px solid var(--line-2); border-bottom-width: 2px; border-radius: var(--r-sm); color: var(--mute); background: var(--surface); }

/* Sky image: always dark, real pixels */
.sky { position: relative; background: var(--sky); border-radius: var(--r); overflow: hidden; aspect-ratio: 1; }
.sky img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; image-rendering: auto; }
.sky .mark { position: absolute; left: 50%; top: 50%; width: 9%; aspect-ratio: 1; transform: translate(-50%, -50%); border: 1.5px solid #ffc861; border-radius: 50%; box-shadow: 0 0 0 1px rgba(0, 0, 0, .35); pointer-events: none; }
.sky .tag { position: absolute; left: 10px; bottom: 10px; font-family: var(--mono); font-size: 11.5px; color: #e9edf5; background: rgba(5, 7, 13, .72); padding: 3px 7px; border-radius: var(--r-sm); }

/* Theme toggle and mockup banner */
.mock-note { font-size: 12px; color: var(--faint); }

/* ---- Motion and loading (owner: "loads a lot smoother and transitioned") ---- */
:root { --t-fast: 150ms; --t-med: 220ms; --t-slow: 320ms; --ease-out: cubic-bezier(.16, 1, .3, 1); }

/* Sky layers: two stacked images; the new frame is decoded first, then faded or cut in. */
.sky .layer { opacity: 0; transition: opacity var(--sky-fade, 180ms) var(--ease-out); }
.sky .layer.on { opacity: 1; }
.sky.loading::after {
    content: ""; position: absolute; left: 0; top: 0; height: 2px; width: 35%;
    background: var(--accent); animation: sk-bar 1.1s var(--ease) infinite;
}
@keyframes sk-bar { from { transform: translateX(-100%); } to { transform: translateX(300%); } }

/* Skeletons shaped like the real content */
.skel { position: relative; overflow: hidden; background: var(--surface-2); border-radius: var(--r-sm); color: transparent !important; }
.skel::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .55), transparent);
    transform: translateX(-100%); animation: sk-shimmer 1.4s var(--ease) infinite;
}
[data-theme="dark"] .skel::after { background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .06), transparent); }
@keyframes sk-shimmer { to { transform: translateX(100%); } }

/* Content entering: fade + 4 px rise, staggered with --i */
.enter { animation: sk-enter var(--t-slow) var(--ease-out) both; animation-delay: calc(var(--i, 0) * 40ms); }
@keyframes sk-enter { from { opacity: 0; transform: translateY(4px); } }

/* Swapping text blocks (target switch): fade out, change, fade in */
.swap { transition: opacity var(--t-fast) var(--ease-out); }
.swap.out { opacity: 0; }

/* Panels and drawers */
.reveal { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows var(--t-med) var(--ease-out), opacity var(--t-med) var(--ease-out); }
.reveal > * { overflow: hidden; }
.reveal.open { grid-template-rows: 1fr; opacity: 1; }

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 1ms !important; animation-iteration-count: 1 !important; transition-duration: 1ms !important; }
    .sky .layer { transition: opacity 120ms linear !important; }
}

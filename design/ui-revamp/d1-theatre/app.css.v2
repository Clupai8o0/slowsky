/* Direction 1: Theatre — Single centred stage + sliding bottom sheets.
   Built atop base.css tokens. Strictly 0–4 px corners; zero pills; no side panels. */

:root {
    --ease-theatre: cubic-bezier(.16, 1, .3, 1);
    --t-state: 120ms;
    --t-fade: 200ms;
    --t-sheet-open: 200ms;
    --t-sheet-close: 150ms;
    --t-target: 260ms;
    --gold: #ffc861;
    --gold-dim: rgba(255, 200, 97, .42);
}

/* Browser surfaces */
::selection {
    background: var(--accent-soft);
    color: var(--ink);
}

html {
    overflow-x: clip;
    scrollbar-width: thin;
    scrollbar-color: var(--line-2) transparent;
}

body {
    overflow-x: clip;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    caret-color: var(--accent);
    transition: background-color 200ms var(--ease-theatre), color 200ms var(--ease-theatre);
}

::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: var(--line-2);
    border-radius: 2px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--mute);
}

/* Accessibility skip link */
.skip-link {
    position: absolute;
    left: 12px;
    top: -48px;
    z-index: 200;
    padding: 8px 12px;
    background: var(--ink);
    color: var(--bg);
    border-radius: var(--r-sm);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: top var(--t-state) var(--ease-theatre);
}

.skip-link:focus {
    top: 10px;
}

/* Theme icon visibility */
.theme-icon-dark {
    display: none;
}

.theme-icon-light {
    display: inline-flex;
}

[data-theme="dark"] .theme-icon-dark {
    display: inline-flex;
}

[data-theme="dark"] .theme-icon-light {
    display: none;
}

.btn-icon,
.theme-icon-light,
.theme-icon-dark,
.search-trigger-icon,
.cmd-search-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

/* ---------------- Top Bar ---------------- */
.topbar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    transition: background-color 200ms var(--ease-theatre), border-color 200ms var(--ease-theatre);
}

.topbar-inner {
    max-width: 980px;
    margin: 0 auto;
    height: 54px;
    padding: 0 20px;
    display: grid;
    grid-template-columns: auto minmax(180px, 380px) auto;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.02em;
    border-radius: var(--r-sm);
    padding: 4px 2px;
}

.brand-logo {
    width: 24px;
    height: 24px;
    border-radius: var(--r-sm);
    display: block;
    box-shadow: 0 0 0 1px rgba(15, 20, 34, .12);
}

[data-theme="dark"] .brand-logo {
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .14);
}

.search-trigger {
    width: 100%;
    height: 36px;
    padding: 0 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    color: var(--mute);
    cursor: pointer;
    text-align: left;
    font-size: 13.5px;
    transition: border-color var(--t-state) var(--ease-theatre), background-color var(--t-state) var(--ease-theatre), color var(--t-state) var(--ease-theatre);
}

.search-trigger:hover {
    border-color: var(--mute);
    color: var(--ink);
}

.search-trigger svg {
    width: 15px;
    height: 15px;
    flex: none;
}

.search-trigger-placeholder {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.topbar-actions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.copy-link-btn.is-copied {
    border-color: var(--accent);
    color: var(--accent);
}

/* ---------------- Target Ribbon ---------------- */
.ribbon-wrap {
    max-width: 980px;
    width: 100%;
    margin: 12px auto 0;
    padding: 0 20px;
}

.target-ribbon {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
}

.target-card {
    position: relative;
    min-height: 58px;
    padding: 8px 10px 10px;
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    color: var(--ink);
    cursor: pointer;
    text-align: left;
    transition: background-color var(--t-state) var(--ease-theatre), border-color var(--t-state) var(--ease-theatre), box-shadow var(--t-state) var(--ease-theatre);
}

.target-card::after {
    content: "";
    position: absolute;
    left: -1px;
    right: -1px;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    opacity: 0;
    transform: scaleX(0.4);
    transition: opacity 160ms var(--ease-theatre), transform 180ms var(--ease-theatre);
}

.target-card:hover {
    border-color: var(--line-2);
    background: var(--surface-2);
}

.target-card[aria-selected="true"] {
    background: var(--surface);
    border-color: var(--line-2);
    box-shadow: var(--shadow);
}

.target-card[aria-selected="true"]::after {
    opacity: 1;
    transform: scaleX(1);
}

.target-thumb {
    width: 34px;
    height: 34px;
    border-radius: var(--r-sm);
    background: var(--sky);
    overflow: hidden;
    flex: none;
    position: relative;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .12);
}

.target-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.target-card-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
}

.target-card-name {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.target-card-hook {
    font-size: 11.5px;
    line-height: 1.28;
    color: var(--mute);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* ---------------- Theatre Stage ---------------- */
.theatre {
    flex: 1;
    width: 100%;
    padding: 18px 20px 36px;
}

.stage-column {
    max-width: 620px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
}

/* Stage Header */
.stage-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    flex-wrap: wrap;
}

.stage-headline {
    font-size: clamp(19px, 2.3vw, 23px);
    font-weight: 500;
    letter-spacing: -0.022em;
    line-height: 1.25;
    color: var(--ink);
}

.stage-meta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
}

.stage-pm,
.stage-meta-sep {
    font-size: 12.5px;
    color: var(--mute);
}

.stage-pm[hidden],
.stage-meta-sep[hidden] {
    display: none;
}

.coord-btn,
.inline-copy-trigger {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 2px 4px;
    margin: -2px -4px;
    border-radius: var(--r-sm);
    color: var(--mute);
    font-size: 12.5px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 3px;
    transition: color var(--t-state) var(--ease-theatre), background-color var(--t-state) var(--ease-theatre);
}

.coord-btn:hover,
.inline-copy-trigger:hover {
    color: var(--ink);
    background: var(--surface-2);
    text-decoration-color: var(--mute);
}

.inline-copied {
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
}

/* Beginner Help Intro above the sky */
.help-intro {
    margin-bottom: 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.help-intro-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.help-intro-title {
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink);
}

.help-more-btn {
    display: none;
    appearance: none;
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink-2);
    font-size: 12px;
    font-weight: 500;
    padding: 0 10px;
    height: 32px;
    cursor: pointer;
    transition: background-color var(--t-state) var(--ease-theatre), border-color var(--t-state) var(--ease-theatre);
}

.help-more-btn:hover {
    background: var(--surface-2);
    color: var(--ink);
}

.help-intro-text {
    font-size: 13.5px;
    line-height: 1.48;
    color: var(--ink-2);
    max-width: 64ch;
}

.help-intro-lead {
    display: inline;
}

.help-intro-more {
    display: inline;
    opacity: 1;
}

.help-intro-more-inner {
    display: inline;
}

/* Plate Shell & Sky Stage */
.plate-shell {
    width: 100%;
    max-width: min(620px, 100%);
    margin: 0 auto;
}

@media (min-width: 800px) and (min-height: 760px) {
    .plate-shell {
        max-width: clamp(380px, calc(100dvh - 380px), 620px);
    }
}

.sky {
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid rgba(15, 20, 34, .18);
    box-shadow: var(--shadow);
    cursor: crosshair;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
}

[data-theme="dark"] .sky {
    border-color: var(--line-2);
}

/* First-load skeleton shimmer over dark sky box without layout shift */
.sky.is-booting::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 6;
    background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.06) 50%, rgba(255,255,255,0) 100%);
    transform: translateX(-100%);
    animation: sk-shimmer 1.3s var(--ease-theatre) infinite;
    pointer-events: none;
}

.sky-viewport {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    transform: scale(var(--fov-scale, 1));
    transition: transform 220ms var(--ease-theatre), opacity 220ms var(--ease-theatre);
}

.sky-pixels {
    position: absolute;
    inset: 0;
}

.sky.loading::after,
.sky-pixels.loading::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    z-index: 12;
    height: 2px;
    width: 35%;
    background: var(--accent);
    animation: sk-bar 1.1s var(--ease) infinite;
    pointer-events: none;
}

/* Dim old frame to 60% during target switch or archive stage reload */
.sky.is-fetching .sky-pixels {
    opacity: 0.6;
    transition: opacity 180ms var(--ease-theatre);
}

/* Slight settle on target arrival (1.04 -> 1) */
.sky.is-settling .sky-pixels {
    animation: plate-settle 260ms var(--ease-theatre) both;
}

@keyframes plate-settle {
    from {
        transform: scale(1.04);
        opacity: 0.65;
    }
    to {
        transform: scale(1);
        opacity: 1;
    }
}

/* SVG Astronomical Overlays */
.sky-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 3;
}

.ov-layer {
    transition: opacity 180ms var(--ease-theatre);
}

.ov-layer[hidden] {
    display: none;
}

.ov-layer.fading-in {
    animation: ov-fade-in 180ms var(--ease-theatre) both;
}

@keyframes ov-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
}

.target-ring {
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
}

.target-ring.is-drawing {
    animation: ring-draw 420ms var(--ease-theatre) both;
}

@keyframes ring-draw {
    from { stroke-dashoffset: 100; }
    to { stroke-dashoffset: 0; }
}

.sky.is-paused .target-ring:not(.is-drawing) {
    animation: ring-pulse 2.6s ease-in-out infinite;
}

@keyframes ring-pulse {
    0%, 100% { stroke-opacity: 1; }
    50% { stroke-opacity: 0.58; }
}

.trail-ring {
    fill: none;
    stroke: rgba(255, 200, 97, .44);
    stroke-width: 0.34;
    stroke-dasharray: 0.9 0.9;
}

.trail-path {
    fill: none;
    stroke: rgba(255, 200, 97, .35);
    stroke-width: 0.3;
    stroke-dasharray: 0.8 0.8;
}

/* Status, Error, Custom, and Corner HUD bars inside Sky */
.sky-status-bar {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 10px;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    background: rgba(5, 7, 13, .84);
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: var(--r-sm);
    color: #eef1f6;
    font-size: 12.5px;
    pointer-events: none;
}

.sky-status-bar[hidden],
.sky-error-bar[hidden],
.sky-badge-top[hidden],
.sky-custom-bar[hidden],
.sky-loupe[hidden] {
    display: none;
}

.sky-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: #7aa2ff;
    flex: none;
    animation: status-blink 0.9s ease-in-out infinite;
}

@keyframes status-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}

.sky-error-bar {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 10px;
    z-index: 9;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    background: rgba(28, 12, 12, .92);
    border: 1px solid rgba(243, 160, 74, .55);
    border-radius: var(--r-sm);
    color: #f9e6d2;
    font-size: 12.5px;
}

.sky-error-bar span {
    flex: 1;
}

.sky-retry-btn,
.sky-custom-reset {
    appearance: none;
    border: 1px solid rgba(255, 255, 255, .28);
    background: rgba(255, 255, 255, .1);
    color: #ffffff;
    border-radius: var(--r-sm);
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
}

.sky-retry-btn:hover,
.sky-custom-reset:hover {
    background: rgba(255, 255, 255, .2);
}

.sky-dismiss-btn {
    appearance: none;
    border: 0;
    background: transparent;
    color: #cbd2df;
    font-size: 16px;
    line-height: 1;
    padding: 2px 4px;
    cursor: pointer;
}

.sky-badge-top {
    position: absolute;
    right: 10px;
    top: 10px;
    z-index: 5;
    padding: 3px 7px;
    background: rgba(5, 7, 13, .76);
    border: 1px solid rgba(255, 255, 255, .15);
    border-radius: var(--r-sm);
    color: #dbe2f0;
    font-family: var(--mono);
    font-size: 11px;
    pointer-events: none;
}

.sky-custom-bar {
    position: absolute;
    left: 10px;
    top: 10px;
    z-index: 7;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    background: rgba(5, 7, 13, .84);
    border: 1px solid rgba(122, 162, 255, .45);
    border-radius: var(--r-sm);
    color: #eef1f6;
    font-size: 11.5px;
}

.sky .tag {
    z-index: 5;
    border: 1px solid rgba(255, 255, 255, .1);
    pointer-events: none;
}

.sky.is-holding .tag {
    border-color: rgba(255, 200, 97, .65);
    color: #ffd98e;
}

.sky-corner-right {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 3px 7px;
    background: rgba(5, 7, 13, .72);
    border: 1px solid rgba(255, 255, 255, .1);
    border-radius: var(--r-sm);
    color: #cbd2df;
    font-size: 11px;
    pointer-events: none;
}

.sky-scale {
    display: inline-flex;
    align-items: center;
    gap: 5px;
}

.sky-scale-bar {
    display: inline-block;
    width: 28px;
    height: 4px;
    border-bottom: 1.5px solid #e9edf5;
    border-left: 1.5px solid #e9edf5;
    border-right: 1.5px solid #e9edf5;
    transition: width 200ms var(--ease-theatre);
}

/* 2x Hover Loupe (square, 4px corners) */
.sky-loupe {
    position: absolute;
    width: 116px;
    height: 116px;
    border-radius: var(--r);
    border: 1px solid rgba(255, 255, 255, .42);
    background: var(--sky);
    box-shadow: 0 8px 24px rgba(0, 0, 0, .55);
    overflow: hidden;
    pointer-events: none;
    z-index: 10;
}

.loupe-inner {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
}

.loupe-inner img,
.loupe-inner canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
}

.loupe-reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 16px;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(255, 200, 97, .75);
    border-radius: 50%;
}

.loupe-label {
    position: absolute;
    right: 4px;
    bottom: 3px;
    padding: 1px 4px;
    font-size: 10px;
    color: #eef1f6;
    background: rgba(5, 7, 13, .75);
    border-radius: var(--r-sm);
}

/* Micro row right below sky plate */
.plate-micro-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 6px;
    font-size: 12px;
    color: var(--mute);
}

.plate-wavelength-chip {
    color: var(--ink-2);
}

/* ---------------- Under-Plate Caption & AI Note ---------------- */
.stage-caption {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 64ch;
}

.stage-show {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
}

.stage-caveat {
    font-size: 13.5px;
    line-height: 1.48;
    color: var(--mute);
}

.control-help {
    font-size: 12px;
    line-height: 1.44;
    color: var(--mute);
}

.ai-note-box {
    margin-top: 12px;
    padding: 10px 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: background-color 200ms var(--ease-theatre), border-color 200ms var(--ease-theatre);
}

.ai-note-label {
    margin: 0;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink);
}

.ai-note-body {
    font-size: 13px;
    line-height: 1.48;
    color: var(--ink-2);
}

/* Glossary dotted-underline buttons & square popover */
.gloss-btn {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0 1px;
    margin: 0 -1px;
    border-radius: var(--r-sm);
    font: inherit;
    color: inherit;
    line-height: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: var(--mute);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color var(--t-state) var(--ease-theatre), background-color var(--t-state) var(--ease-theatre);
}

.gloss-btn:hover,
.gloss-btn[aria-expanded="true"] {
    color: var(--accent);
    text-decoration-color: var(--accent);
    background: var(--accent-soft);
}

.gloss-popover {
    position: fixed;
    z-index: 95;
    width: max-content;
    max-width: min(310px, calc(100vw - 24px));
    padding: 9px 11px;
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    box-shadow: var(--shadow);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    animation: ov-fade-in 140ms var(--ease-theatre) both;
}

.gloss-popover[hidden] {
    display: none;
}

.gloss-popover-text {
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--ink);
    flex: 1;
}

.gloss-popover-close {
    appearance: none;
    border: 1px solid transparent;
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--mute);
    width: 22px;
    height: 22px;
    padding: 0;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
}

.gloss-popover-close:hover {
    color: var(--ink);
    background: var(--surface-2);
}

/* ---------------- Unified Dock ---------------- */
.dock {
    margin-top: 16px;
    padding: 12px 14px;
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: background-color 200ms var(--ease-theatre), border-color 200ms var(--ease-theatre);
}

.dock-row-top {
    display: flex;
    align-items: center;
    gap: 12px;
}

.transport-group {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: none;
}

.play-btn[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
}

.play-btn[aria-pressed="true"]:hover {
    opacity: 0.92;
}

/* Date Scrubber */
.scrubber-wrap {
    position: relative;
    flex: 1;
    min-width: 120px;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.scrubber-labels {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    font-size: 12px;
}

.scrubber-date-active {
    color: var(--ink);
    font-weight: 500;
}

.scrubber-visit-count {
    color: var(--mute);
    font-size: 11.5px;
}

.scrubber-track-area {
    position: relative;
    height: 24px;
    display: flex;
    align-items: center;
    cursor: pointer;
    touch-action: none;
    border-radius: var(--r-sm);
}

.scrubber-rail {
    position: absolute;
    left: 7px;
    right: 7px;
    height: 3px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 1px;
    overflow: hidden;
}

.scrubber-fill {
    height: 100%;
    width: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
    transition: width 150ms var(--ease-theatre);
}

.scrubber-ticks {
    position: absolute;
    left: 7px;
    right: 7px;
    top: 0;
    bottom: 0;
}

.scrubber-tick {
    position: absolute;
    top: 50%;
    width: 14px;
    height: 22px;
    transform: translate(-50%, -50%);
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
}

.scrubber-tick::after {
    content: "";
    width: 5px;
    height: 9px;
    border-radius: 1px;
    background: var(--line-2);
    border: 1px solid var(--surface);
    transition: background-color var(--t-state) var(--ease-theatre), transform var(--t-state) var(--ease-theatre);
}

.scrubber-tick:hover::after,
.scrubber-tick.is-past::after {
    background: var(--accent);
}

.scrubber-tick:hover::after {
    transform: scaleY(1.25);
}

.scrubber-thumb {
    position: absolute;
    top: 50%;
    left: 7px;
    width: 11px;
    height: 15px;
    transform: translate(-50%, -50%);
    background: var(--ink);
    border: 1.5px solid var(--surface);
    border-radius: var(--r-sm);
    box-shadow: 0 1px 3px rgba(0, 0, 0, .25);
    pointer-events: none;
    transition: left 150ms var(--ease-theatre);
}

/* Hover-peek thumbnail card */
.scrubber-peek {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    width: 118px;
    padding: 5px;
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    box-shadow: var(--shadow);
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.scrubber-peek[hidden] {
    display: none;
}

.peek-thumb-box {
    width: 100%;
    aspect-ratio: 1;
    background: var(--sky);
    border-radius: var(--r-sm);
    overflow: hidden;
}

.peek-thumb-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.peek-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
}

.peek-date {
    font-size: 11px;
    font-weight: 500;
    color: var(--ink);
}

.peek-sub {
    font-size: 10.5px;
    color: var(--mute);
}

.mode-seg {
    flex: none;
}

.dock-mode-hint {
    font-size: 12px;
    color: var(--mute);
    line-height: 1.44;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--line);
}

/* Wavelength Row */
.dock-row-wl {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.wl-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
}

.wl-title-group {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
}

.wl-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
}

.wl-value {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
}

.wl-det-meta {
    font-size: 12px;
    color: var(--mute);
}

.wl-status-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
}

.wl-source-note {
    color: var(--mute);
}

.wl-source-note.is-sim {
    color: var(--warm);
}

.wl-reset-btn {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--accent);
    font-size: 12px;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
}

.wl-bar-container {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 6px;
}

/* Visible light edge (<= 0.70 um, shortened to "eyes" with full tooltip + aria-label) */
.wl-eyes-zone {
    flex: 0 0 46px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border: 1px dashed var(--line-2);
    border-right: 2px solid var(--ink-2);
    border-radius: var(--r-sm) 0 0 var(--r-sm);
    background: var(--surface-2);
    overflow: hidden;
    cursor: help;
}

.wl-eyes-spectrum {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    opacity: 0.22;
    background: linear-gradient(90deg, #3b66e4 0%, #37b37e 45%, #e5b83b 75%, #d6453a 100%);
}

.wl-eyes-label {
    position: relative;
    font-size: 10.5px;
    color: var(--ink-2);
    white-space: nowrap;
}

/* Interactive 6-detector infrared bar: thin thumb track above unobstructed detector bands */
.wl-interactive {
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    cursor: pointer;
    touch-action: none;
    border-radius: var(--r-sm);
}

.wl-track {
    position: relative;
    height: 10px;
    width: 100%;
}

.wl-track-rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    transform: translateY(-50%);
    background: var(--surface-2);
    border: 1px solid var(--line-2);
    border-radius: 1px;
}

.wl-bands {
    position: relative;
    display: flex;
    gap: 2px;
    height: 26px;
    width: 100%;
}

.wl-band {
    position: relative;
    min-width: 25px;
    height: 100%;
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--surface-2);
    color: var(--mute);
    font-family: var(--mono);
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: background-color var(--t-state) var(--ease-theatre), border-color var(--t-state) var(--ease-theatre), color var(--t-state) var(--ease-theatre);
}

.wl-band:hover {
    border-color: var(--mute);
    color: var(--ink);
}

.wl-band.is-native {
    border-bottom: 2px solid var(--accent);
    color: var(--ink);
}

.wl-band.is-active {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--ink);
    font-weight: 500;
}

.wl-thumb {
    position: absolute;
    top: 50%;
    left: 0;
    width: 9px;
    height: 11px;
    transform: translate(-50%, -50%);
    background: var(--ink);
    border: 1.5px solid var(--surface);
    border-radius: var(--r-sm);
    box-shadow: 0 1px 3px rgba(0, 0, 0, .28);
    pointer-events: none;
    transition: left 90ms linear;
}

.wl-interactive.is-dragging .wl-thumb {
    transition: none;
}

.wl-hover-tip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    padding: 3px 8px;
    background: var(--ink);
    color: var(--bg);
    border-radius: var(--r-sm);
    font-size: 11px;
    white-space: nowrap;
    pointer-events: none;
}

.wl-hover-tip[hidden] {
    display: none;
}

/* ---------------- Underlined Sheet Triggers ---------------- */
.sheet-bar {
    margin-top: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    flex-wrap: wrap;
}

.sheet-link {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 6px 4px;
    min-height: 36px;
    border-radius: var(--r-sm);
    cursor: pointer;
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    color: var(--ink);
    font-size: 13.5px;
    font-weight: 500;
    transition: color var(--t-state) var(--ease-theatre);
}

.sheet-link-text {
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--t-state) var(--ease-theatre);
}

.sheet-link:hover .sheet-link-text,
.sheet-link[aria-expanded="true"] .sheet-link-text {
    text-decoration-color: var(--accent);
}

.sheet-link[aria-expanded="true"] {
    color: var(--accent);
}

.sheet-link-meta {
    font-size: 11.5px;
    font-weight: 400;
    color: var(--mute);
}

/* ---------------- Footer ---------------- */
.theatre-footer {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
}

.shortcut-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 12px;
    color: var(--mute);
}

.shortcut-row span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.theatre-footer .mock-note {
    color: var(--mute);
    max-width: 62ch;
    line-height: 1.45;
}

.ai-footer-note a {
    margin-left: 4px;
    font-size: 12px;
    white-space: nowrap;
}

/* ---------------- Sliding Bottom Sheet (~58% height, sky stays visible above) ---------------- */
.sheet-backdrop {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(15, 20, 34, .14);
    opacity: 0;
    transition: opacity var(--t-sheet-open) var(--ease-theatre);
}

[data-theme="dark"] .sheet-backdrop {
    background: rgba(0, 0, 0, .38);
}

.sheet-backdrop.is-open {
    opacity: 1;
}

.sheet-backdrop[hidden],
.bottom-sheet[hidden] {
    display: none;
}

.bottom-sheet {
    position: fixed;
    left: 50%;
    bottom: 0;
    z-index: 45;
    width: min(760px, 100vw);
    max-height: min(56dvh, 480px);
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-bottom: 0;
    border-radius: var(--r) var(--r) 0 0;
    box-shadow: 0 -8px 36px rgba(15, 20, 34, .18);
    transform: translate(-50%, 24px);
    opacity: 0;
    transition: transform var(--t-sheet-open) var(--ease-theatre), opacity var(--t-sheet-open) var(--ease-theatre), background-color 200ms var(--ease-theatre);
}

[data-theme="dark"] .bottom-sheet {
    box-shadow: 0 -10px 42px rgba(0, 0, 0, .65);
}

.bottom-sheet.is-open {
    transform: translate(-50%, 0);
    opacity: 1;
}

.bottom-sheet.is-closing {
    transform: translate(-50%, 18px);
    opacity: 0;
    transition-duration: var(--t-sheet-close);
}

.sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 14px 0;
    border-bottom: 1px solid var(--line);
    flex: none;
}

.sheet-tabs {
    display: flex;
    align-items: center;
    gap: 16px;
    overflow-x: auto;
}

.sheet-tab {
    appearance: none;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    padding: 10px 2px;
    margin-bottom: -1px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--mute);
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--t-state) var(--ease-theatre), border-color var(--t-state) var(--ease-theatre);
}

.sheet-tab:hover {
    color: var(--ink);
}

.sheet-tab[aria-selected="true"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
}

.sheet-close {
    margin-bottom: 6px;
}

.sheet-body {
    padding: 18px 20px 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
}

.sheet-panel[hidden] {
    display: none;
}

/* Sheet 1: What to look for */
.guide-prose {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 18px;
}

.guide-prose-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
}

.guide-prose-head h3 {
    font-size: 17px;
    font-weight: 500;
}

.guide-lead {
    font-size: 14.5px;
    color: var(--ink-2);
    max-width: 68ch;
}

.guide-caveat-block {
    padding: 10px 12px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r);
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.subhead {
    margin: 0;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink);
}

.guide-caveat-block p {
    font-size: 13.5px;
    color: var(--mute);
    max-width: 68ch;
}

.guide-diagrams {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 14px;
}

.diagram-box {
    padding: 12px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r);
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.diagram-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
}

.diagram-sub {
    font-size: 11.5px;
    color: var(--mute);
}

/* Interactive Sky Map */
.skymap-wrap {
    position: relative;
    background: var(--sky);
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    overflow: hidden;
}

.skymap-svg {
    display: block;
    width: 100%;
    height: auto;
}

.skymap-eq {
    stroke: rgba(255, 255, 255, .18);
    stroke-width: 1;
}

.skymap-grid {
    stroke: rgba(255, 255, 255, .08);
    stroke-width: 1;
    stroke-dasharray: 2 3;
}

.skymap-plane {
    stroke: rgba(122, 162, 255, .2);
    stroke-width: 1.2;
}

.skymap-axis {
    fill: #8b93a3;
    font-family: var(--mono);
    font-size: 9.5px;
}

.skymap-star {
    cursor: pointer;
    outline: none;
}

.skymap-star-hit {
    fill: transparent;
}

.skymap-star-dot {
    fill: #cbd5e8;
    transition: fill var(--t-state) var(--ease-theatre), r var(--t-state) var(--ease-theatre);
}

.skymap-star:hover .skymap-star-dot,
.skymap-star:focus-visible .skymap-star-dot {
    fill: #ffffff;
}

.skymap-star.is-current .skymap-star-dot {
    fill: var(--gold);
}

.skymap-star-ring {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.3;
    opacity: 0;
    transition: opacity 160ms var(--ease-theatre);
}

.skymap-star.is-current .skymap-star-ring {
    opacity: 1;
}

.skymap-star:focus-visible .skymap-star-ring {
    opacity: 1;
    stroke: #7aa2ff;
}

.skymap-hover-card {
    position: absolute;
    left: 8px;
    bottom: 8px;
    right: 8px;
    padding: 5px 8px;
    background: rgba(5, 7, 13, .88);
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: var(--r-sm);
    color: #eef1f6;
    font-size: 11.5px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    pointer-events: none;
}

.skymap-hover-card[hidden] {
    display: none;
}

.skymap-hover-card span {
    color: #9aa2b2;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Animated Proper Motion Diagram */
.motion-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.motion-svg {
    display: block;
    width: 100%;
    height: auto;
    background: var(--sky);
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    color: var(--gold);
}

.motion-axis {
    stroke: rgba(255, 255, 255, .11);
    stroke-width: 1;
}

.motion-ring-guide {
    stroke: rgba(255, 255, 255, .1);
    stroke-width: 1;
    stroke-dasharray: 2 3;
}

.motion-line-full {
    stroke: rgba(255, 200, 97, .28);
    stroke-width: 1.4;
    stroke-dasharray: 3 3;
}

.motion-line-active {
    stroke: var(--gold);
    stroke-width: 2;
    transition: x2 150ms var(--ease-theatre), y2 150ms var(--ease-theatre);
}

.motion-visit-dot {
    fill: rgba(255, 200, 97, .38);
    cursor: pointer;
}

.motion-visit-dot.is-active {
    fill: var(--gold);
    stroke: #05070d;
    stroke-width: 1.2;
}

.motion-caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 11.5px;
    color: var(--ink-2);
}

.motion-components {
    font-size: 11px;
    color: var(--mute);
}

/* Guide sheet glossary reference */
.glossary-ref {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.glossary-ref-list {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 14px;
}

.glossary-ref-item {
    padding: 8px 10px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r);
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.glossary-ref-item dt {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
}

.glossary-ref-item dd {
    margin: 0;
    font-size: 12px;
    line-height: 1.44;
    color: var(--mute);
}

/* Sheet 2: Overlays & field */
.overlays-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 24px;
}

.overlays-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.panel-heading {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
}

.checks-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.check-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.check-help {
    padding-left: 26px;
}

.overlay-mock-note {
    padding-left: 26px;
    margin-top: 2px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--mute);
}

.overlay-mock-note[hidden] {
    display: none;
}

.false-colour-note {
    margin-top: 4px;
    padding: 9px 11px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r);
    font-size: 13px;
    color: var(--mute);
}

.field-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.field-desc {
    font-size: 13px;
    color: var(--mute);
}

.source-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.test-err-btn {
    font-size: 12.5px;
    color: var(--mute);
    height: 32px;
    padding: 0 10px;
}

/* Sheet 3: This frame */
.frame-spec-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
}

.fits-feedback {
    margin-bottom: 12px;
    padding: 8px 11px;
    background: var(--accent-soft);
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    font-size: 13px;
    color: var(--ink);
}

.spec-grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 18px;
}

.spec-item {
    padding: 8px 10px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r);
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.spec-item dt {
    font-size: 11.5px;
    color: var(--mute);
}

.spec-item dd {
    margin: 0;
    font-size: 13px;
    color: var(--ink);
    word-break: break-word;
}

/* ---------------- Centred Command Palette (⌘K) ---------------- */
.cmd-backdrop {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(15, 20, 34, .36);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 12dvh 16px 24px;
    animation: ov-fade-in 150ms var(--ease-theatre) both;
}

[data-theme="dark"] .cmd-backdrop {
    background: rgba(0, 0, 0, .62);
}

.cmd-backdrop[hidden] {
    display: none;
}

.cmd-dialog {
    width: min(540px, 100%);
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    box-shadow: 0 20px 56px rgba(15, 20, 34, .28);
    overflow: hidden;
    animation: cmd-pop 180ms var(--ease-theatre) both;
}

@keyframes cmd-pop {
    from {
        opacity: 0;
        transform: translateY(-6px) scale(0.985);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.cmd-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
    height: 48px;
    border-bottom: 1px solid var(--line);
}

.cmd-search-icon svg {
    width: 16px;
    height: 16px;
    color: var(--mute);
}

.cmd-input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    font-size: 14.5px;
    color: var(--ink);
    outline: none;
}

.cmd-input::placeholder {
    color: var(--mute);
}

.cmd-esc-btn {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 2px;
    cursor: pointer;
}

.cmd-list {
    max-height: 320px;
    overflow-y: auto;
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.cmd-item {
    width: 100%;
    padding: 8px 10px;
    border: 0;
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    text-align: left;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: background-color 100ms var(--ease-theatre);
}

.cmd-item:hover,
.cmd-item[aria-selected="true"] {
    background: var(--surface-2);
}

.cmd-item[aria-selected="true"] {
    box-shadow: inset 2px 0 0 var(--accent);
}

.cmd-item-thumb {
    width: 32px;
    height: 32px;
    border-radius: var(--r-sm);
    background: var(--sky);
    overflow: hidden;
    flex: none;
    display: grid;
    place-items: center;
    color: #9aa2b2;
    font-family: var(--mono);
    font-size: 11px;
}

.cmd-item-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.cmd-item-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
}

.cmd-item-title {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink);
}

.cmd-item-sub {
    font-size: 12px;
    color: var(--mute);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cmd-item-meta {
    font-size: 11.5px;
    color: var(--mute);
    flex: none;
}

.cmd-footer {
    padding: 8px 12px;
    border-top: 1px solid var(--line);
    background: var(--surface-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 11.5px;
    color: var(--mute);
}

/* ---------------- Responsive Breakpoints ---------------- */
@media (max-width: 860px) {
    .target-card {
        padding: 7px 8px 9px;
        gap: 7px;
    }

    .target-thumb {
        width: 28px;
        height: 28px;
    }

    .target-card-name {
        font-size: 12px;
    }

    .target-card-hook {
        font-size: 11px;
    }

    .guide-diagrams,
    .overlays-grid,
    .glossary-ref-list {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 799px) {
    body {
        min-height: 0;
    }

    .theatre {
        flex: 0 0 auto;
    }

    .dock {
        position: static;
    }
}

@media (max-width: 680px) {
    .topbar-inner {
        padding: 0 12px;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: 8px;
    }

    .search-trigger-kbd {
        display: none;
    }

    .copy-link-btn #copy-link-label {
        display: none;
    }

    .copy-link-btn {
        width: 44px;
        height: 44px;
        padding: 0;
        justify-content: center;
    }

    .theme-btn {
        width: 44px;
        height: 44px;
    }

    .search-trigger {
        height: 40px;
    }

    .ribbon-wrap {
        padding: 0 12px;
        margin-top: 10px;
    }

    .target-ribbon {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 6px;
    }

    .target-ribbon .target-card:last-child {
        grid-column: 1 / -1;
    }

    .target-card {
        min-height: 48px;
    }

    .theatre {
        padding: 14px 12px 24px;
    }

    .help-more-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 36px;
        min-width: 52px;
    }

    .help-intro:not(.is-expanded) .help-intro-lead {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .help-intro.is-expanded .help-intro-lead {
        display: block;
    }

    .help-intro-more {
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        transition: grid-template-rows var(--t-med) var(--ease-out), opacity var(--t-med) var(--ease-out);
    }

    .help-intro-more.open {
        grid-template-rows: 1fr;
        opacity: 1;
    }

    .help-intro-more-inner {
        display: block;
        overflow: hidden;
    }

    .help-intro-more.open .help-intro-more-inner {
        padding-top: 4px;
    }

    .dock {
        position: static;
        margin-top: 14px;
        padding: 10px 12px 12px;
        border: 1px solid var(--line-2);
        border-radius: var(--r);
        box-shadow: var(--shadow);
    }

    .dock-row-top {
        flex-wrap: wrap;
        gap: 8px;
    }

    .scrubber-wrap {
        min-width: 110px;
    }

    .transport-group .btn.icon {
        width: 44px;
        height: 44px;
    }

    .mode-seg {
        width: 100%;
        justify-content: stretch;
    }

    .mode-seg button {
        flex: 1;
        height: 40px;
        justify-content: center;
    }

    .wl-eyes-zone {
        flex: 0 0 42px;
        height: 30px;
    }

    .wl-eyes-label {
        font-size: 10px;
    }

    .wl-track {
        height: 12px;
    }

    .wl-bands {
        height: 30px;
    }

    .wl-band {
        min-width: 24px;
        font-size: 10.5px;
    }

    .sheet-bar {
        gap: 12px;
    }

    .sheet-link {
        min-height: 44px;
        padding: 8px 6px;
    }

    .bottom-sheet {
        width: 100vw;
        max-height: 60dvh;
        border-left: 0;
        border-right: 0;
    }

    .sheet-body {
        padding: 14px 14px 22px;
    }

    .spec-grid {
        grid-template-columns: 1fr;
    }

    .shortcut-row {
        display: none;
    }
}

@media (max-width: 359px) {
    .brand-name {
        font-size: 14px;
    }

    .search-trigger {
        padding: 0 8px;
        font-size: 12.5px;
    }

    .plate-micro-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .sky.is-paused .target-ring {
        animation: none !important;
    }

    .sky-status-dot {
        animation: none !important;
    }
}
